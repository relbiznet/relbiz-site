---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="notfound">
    <div class="notfound__code" role="img" aria-label="404">
      <span>4</span>
      <svg viewBox="0 0 100 100" fill="none" aria-hidden="true" style="width: clamp(96px, 12vw, 160px); height: auto;"><circle cx="50" cy="50" r="46" fill="#1F4FBF"></circle><g stroke="#FFFFFF" stroke-width="2.4"><circle cx="50" cy="50" r="30"></circle><path d="M20 50h60M50 20c9 8 13 18 13 30s-4 22-13 30c-9-8-13-18-13-30s4-22 13-30z"></path></g><circle cx="78" cy="22" r="7" fill="#E8B400"></circle></svg>
      <span>4</span>
    </div>
    <h1 class="h2" style="margin-top: 32px;">This page could not be found</h1>
    <p class="text" style="margin: 14px 0 0; max-width: 460px; font-size: 17px;">The page may have moved when we rebuilt the site. Our partners, countries and news are still here.</p>
    <div class="btn-row" style="justify-content: center;">
      <a class="btn btn--blue" href="/">Back to home</a>
      <a class="btn btn--line" href="/countries/">Countries</a>
      <a class="btn btn--line" href="/news/">News</a>
    </div>
  </section>
</Base>
