---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Crumb { name: string; url: string }
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  breadcrumbs?: Crumb[];
  showTopbar?: boolean;
  published?: Date;
}
const {
  title,
  description = site.description,
  keywords,
  image,
  type = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbs = [],
  showTopbar = false,
  published,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://relbiz.net';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title.includes('RelBiz.NET') ? title : `${title} | RelBiz.NET`;
const ogPath = '/og' + (Astro.url.pathname === '/' ? '/home' : Astro.url.pathname.replace(/\/$/, '')) + '.png';
const ogImage = new URL(image ?? ogPath, siteUrl).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'RelBiz.NET',
  legalName: 'RelBiz LLC',
  url: siteUrl + '/',
  logo: `${siteUrl}/apple-touch-icon.png`,
  foundingDate: String(site.foundingYear),
  description: site.description,
  email: site.email,
  telephone: site.phones.map((p) => p.number),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.office.street,
    addressLocality: site.office.city,
    postalCode: site.office.postalCode,
    addressCountry: 'PL',
  },
  sameAs: Object.values(site.social),
};
const crumbsLd = breadcrumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, siteUrl).toString() })),
    }]
  : [];
const ld = [organization, ...crumbsLd, ...jsonLd];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0B1F3A" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="RelBiz.NET" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_GB" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <Header showTopbar={showTopbar} />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <div class="cookie" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
    <p>We use cookies for website analytics (Google Analytics) only with your consent. Essential site functions work without them. <a href="/privacy/">Learn more</a>.</p>
    <div class="cookie__btns">
      <button type="button" class="btn btn--line btn--sm" data-consent="necessary">Only necessary</button>
      <button type="button" class="btn btn--blue btn--sm" data-consent="all">Accept analytics</button>
    </div>
  </div>

  <script is:inline define:vars={{ ga4: site.analytics.ga4 }}>
    (function () {
      var KEY = 'rb-consent';
      var banner = document.getElementById('cookie-banner');
      function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
      function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
      function loadAnalytics() {
        if (window.__rbAnalytics) return; window.__rbAnalytics = true;
        if (ga4) {
          var s = document.createElement('script'); s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4; document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date()); gtag('config', ga4, { anonymize_ip: true });
        }
      }
      var c = get();
      if (c === 'all') loadAnalytics(); else if (!c && banner) banner.hidden = false;
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-consent]');
        if (b) { var v = b.getAttribute('data-consent'); set(v); banner.hidden = true; if (v === 'all') loadAnalytics(); }
        if (e.target.closest('[data-cookie-settings]')) { banner.hidden = false; }
      });
    })();
  </script>

  <script is:inline>
    // External links inside articles open in a new tab.
    document.querySelectorAll('.prose a[href^="http"]').forEach(function (a) {
      if (a.hostname !== location.hostname) { a.target = '_blank'; a.rel = 'noopener'; }
    });
    // Preselect the form topic from ?topic=… links.
    var topicParam = new URLSearchParams(location.search).get('topic');
    if (topicParam) document.querySelectorAll('select[name="topic"]').forEach(function (s) {
      var found = Array.prototype.some.call(s.options, function (o) { return o.text === topicParam; });
      if (!found) { var o = document.createElement('option'); o.text = topicParam; s.add(o, 1); }
      s.value = topicParam;
    });
    // Request forms: sent through Web3Forms when a key is configured, otherwise opens the visitor's e-mail program.
    document.querySelectorAll('.js-form').forEach(function (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var status = form.querySelector('.form-status');
        var btn = form.querySelector('button[type="submit"]');
        if (!form.checkValidity()) { status.textContent = 'Please fill in your name, e-mail and message.'; status.className = 'form-status form-status--err'; form.reportValidity(); return; }
        var data = Object.fromEntries(new FormData(form).entries());
        if (data.botcheck) return;
        data.page = location.href;
        var key = form.dataset.key;
        if (!key) {
          var body = Object.keys(data).filter(function (k) { return data[k] && ['subject', 'from_name', 'botcheck'].indexOf(k) < 0; }).map(function (k) { return k + ': ' + data[k]; }).join('\n');
          location.href = 'mailto:' + form.dataset.fallback + '?subject=' + encodeURIComponent(data.subject) + '&body=' + encodeURIComponent(body);
          return;
        }
        data.access_key = key;
        btn.disabled = true; status.textContent = 'Sending…'; status.className = 'form-status';
        try {
          var r = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
          var j = await r.json();
          if (j.success) { form.reset(); status.textContent = 'Thank you! We will get back to you shortly.'; status.className = 'form-status form-status--ok'; }
          else throw new Error(j.message);
        } catch (err) {
          status.textContent = 'Sorry, the message could not be sent. Please write to ' + form.dataset.fallback + '.'; status.className = 'form-status form-status--err';
        } finally { btn.disabled = false; }
      });
    });
  </script>
  <script is:inline>
    // YouTube players: the iframe is created only after the visitor presses play.
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.yt__play');
      if (!b) return;
      var f = document.createElement('iframe');
      var start = Number(b.dataset.start) || 0;
      f.src = 'https://www.youtube-nocookie.com/embed/' + b.dataset.yt + '?autoplay=1&rel=0' + (start ? '&start=' + start : '');
      f.title = b.dataset.title || 'YouTube video';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      b.replaceWith(f);
    });
  </script>
</body>
</html>
