---
import site from '../data/site.json';
interface Props { showTopbar?: boolean }
const { showTopbar = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/#about', label: 'About', match: '/about' },
  { href: '/services/', label: 'Services', match: '/services' },
  { href: '/countries/', label: 'Countries', match: '/countries' },
  { href: '/news/', label: 'News', match: '/news' },
  { href: '/contacts/', label: 'Contacts', match: '/contacts' },
];
---
{showTopbar && (
  <div class="topbar">
    <div class="wrap">
      <div class="topbar__group">
        {site.phones.map((p) => <a href={`tel:${p.tel}`}><b>{p.label}</b> {p.number}</a>)}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <span>WhatsApp · Telegram · Viber</span>
    </div>
  </div>
)}
<header class="header">
  <div class="wrap">
    <a class="header__logo" href="/" aria-label="RelBiz.NET — home">
      <img src="/images/relbiz-logo.svg" alt="RelBiz.NET — Reliable Business" width="205" height="48" />
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn--blue btn--sm" href="/contacts/#form">Find a partner</a>
  </div>
</header>
